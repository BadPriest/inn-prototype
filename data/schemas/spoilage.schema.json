{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Spoilage",
  "description": "Spoilage stages and profiles. Default stage names: fresh, onTheTurn, stale, spoiled.",
  "type": "object",
  "additionalProperties": false,
  "required": ["stageEffects", "profiles"],
  "properties": {
    "$schema": { "type": "string" },
    "stageEffects": {
      "type": "object",
      "description": "Effect of each default stage. Profiles and items can override them.",
      "required": ["fresh", "onTheTurn", "stale", "spoiled"],
      "additionalProperties": { "$ref": "common.schema.json#/definitions/stageEffect" }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stages"],
        "properties": {
          "stages": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 }, "description": "Stage id: game days until it starts." },
          "stageEffects": { "type": "object", "additionalProperties": { "$ref": "common.schema.json#/definitions/partialStageEffect" }, "description": "Effects of this profile's own stages, or overrides of the defaults." }
        }
      }
    }
  }
}
